# Copy to secrets.yaml (gitignored) and fill in.
# Generate random values with: openssl rand -base64 32

wifi_ssid: "your-2.4GHz-network"
wifi_password: "your-wifi-password"
fallback_ap_password: "at-least-8-characters"

# Encrypts the Home Assistant API and OTA updates (32 random bytes, base64)
api_encryption_key: "paste-output-of-openssl-rand-base64-32"

# Login for the Tab5's own web page
web_username: "admin"
web_password: "random-string"

# House location for the console's sunset/sunrise theme switch (city-level is enough)
house_latitude: "0.0"
house_longitude: "0.0"
