# Test overlay for the throwaway HA (docker --env-file, read by run.sh e2e).
# Port 8124, so it never collides with the dev HA on 8123. HA 2026.10 deprecates `http:` in
# YAML: it migrates it to .storage as an unconfirmed trial and reverts to 8123 after five
# minutes, so the port comes from HA's SETUP_PORT default instead.
SETUP_PORT=8124
TZ=America/New_York
